# Copy to .env.local and fill in. Never commit the filled-in file.
#
# Nothing reads these yet — Phase 0 has no application code. They are the keys
# the architecture in docs/ARCHITECTURE.md will need.

# Connection string for the Payload database.
# Host is an open decision — see docs/ARCHITECTURE.md.
DATABASE_URI=

# Secret used by Payload to sign and encrypt. Long, random, unique per
# environment. Rotating it invalidates existing sessions.
PAYLOAD_SECRET=

# Absolute public URL of this site, including scheme and no trailing slash.
# Used for generating absolute links and share-card metadata.
# Example: https://example.com
NEXT_PUBLIC_SERVER_URL=

# Where uploaded images and video are stored.
# Open decision — local, object storage, or a managed media service.
# See docs/ARCHITECTURE.md.
MEDIA_STORAGE_URL=
